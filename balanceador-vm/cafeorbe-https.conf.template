# CaféOrbe · NGINX de cada máquina virtual detrás del Azure Load Balancer (puerto 443).
# __DOMINIO__, __API_HOST__ y __WS_HOST__ los reemplaza scripts/balanceador-azure.sh al instalarlo.

server {
  listen 443 ssl;
  server_name __DOMINIO__;
  server_tokens off;
  access_log /var/log/nginx/cafeorbe.log cafeorbe;

  ssl_certificate     /etc/letsencrypt/live/__DOMINIO__/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/__DOMINIO__/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  # Qué máquina virtual atendió la petición (para mostrar el reparto del balanceador).
  add_header X-CafeOrbe-VM $hostname always;

  proxy_http_version 1.1;
  proxy_ssl_server_name on;
  proxy_connect_timeout 3s;
  # El Azure Load Balancer es de capa 4 y conserva la IP del cliente: las auditorías de SEG-01 a SEG-05 la reciben.
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;

  location = /lb/salud {
    access_log off;
    default_type text/plain;
    return 200 "UP $hostname\n";
  }

  # WebSocket → realtime-gateway
  location /ws/ {
    proxy_pass https://__WS_HOST__;
    proxy_ssl_name __WS_HOST__;
    proxy_set_header Host __WS_HOST__;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # REST → api-gateway
  location / {
    proxy_pass https://__API_HOST__;
    proxy_ssl_name __API_HOST__;
    proxy_set_header Host __API_HOST__;
    proxy_read_timeout 60s;
  }
}
