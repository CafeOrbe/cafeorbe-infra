{
  "__inputs": [
    { "name": "DS_PROM", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "title": "CaféOrbe · Negocio",
  "uid": "cafeorbe-negocio",
  "tags": ["cafeorbe", "sprint2"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat", "title": "Pujas aceptadas / min",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [{ "refId": "A", "expr": "sum(rate(cafeorbe_auction_pujas_total{resultado=\"aceptada\"}[1m])) * 60 or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "type": "stat", "title": "Conexiones WebSocket abiertas",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [{ "refId": "A", "expr": "sum(cafeorbe_realtime_conexiones)" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" }
    },
    {
      "type": "stat", "title": "Logins con Google (última hora)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [{ "refId": "A", "expr": "sum(increase(cafeorbe_seguridad_eventos_total{evento=\"login_google\"}[1h])) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" }
    },
    {
      "type": "stat", "title": "Eventos pendientes en la outbox",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [{ "refId": "A", "expr": "max(cafeorbe_outbox_pendientes)" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 100 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "type": "timeseries", "title": "Pujas por minuto (aceptadas y rechazadas)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "interval": "10s",
      "targets": [{ "refId": "A", "expr": "sum by (resultado) (rate(cafeorbe_auction_pujas_total[1m])) * 60", "legendFormat": "{{resultado}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Pujas rechazadas por motivo (por minuto)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "interval": "10s",
      "targets": [{ "refId": "A", "expr": "sum by (motivo) (rate(cafeorbe_auction_pujas_total{resultado=\"rechazada\"}[1m])) * 60", "legendFormat": "{{motivo}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Conexiones WebSocket por réplica",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "interval": "10s",
      "targets": [{ "refId": "A", "expr": "sum by (instancia) (cafeorbe_realtime_conexiones)", "legendFormat": "{{instancia}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
