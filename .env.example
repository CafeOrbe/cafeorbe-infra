# Copia este archivo como .env y ajusta los valores. .env está en .gitignore.

# Secreto compartido para firmar/validar el token de sesión (HS256, mínimo 32 caracteres)
JWT_SECRET=cafeorbe-dev-jwt-secret-cambiar-en-prod-0123456789

# Credenciales del broker
RABBIT_USER=cafeorbe
RABBIT_PASSWORD=cafeorbe

# Superusuario de Postgres (los servicios usan sus propios usuarios, ver postgres/01-bases-de-datos.sql)
POSTGRES_PASSWORD=postgres

# Proveedor de video (LiveKit)
LIVEKIT_API_KEY=cafeorbe
LIVEKIT_API_SECRET=cafeorbe-livekit-dev-secret-cambiar-en-prod-0123456789

# Orígenes permitidos por CORS / WebSocket
CORS_ORIGINS=http://localhost:5173

# Saldo inicial de Orbes que recibe un Comprador (HU-07)
WALLET_SALDO_INICIAL=1000
